<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Or leave it and push a theme instead: tools/theme.sh themes/<name> puts a config.json (same keys, see
  themes/README.md) and an optional wallpaper on the TV, and the launcher overlays it at start.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>
    <!-- The launcher's name in the TV's app list and home picker; the same in every language. -->
    <string name="launcher_name" translatable="false">CleanXiaomiTV</string>


    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.google.android.youtube.tv</item>
        <item>net.mbc.shahidTV</item>
        <item>com.nuvio.tv</item>
        <item>com.sportzx.live</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.mitv.livetv</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.mitv.livetv</string>

    <!-- Some TVs give their Live TV app no leanback entry point at all, so `live_tv_package` above
         resolves to nothing (TCL Android TV 9 on China-market sets is one). This action is then sent
         to that package instead, and the app starts normally. Leave empty to omit. -->
    <string name="live_tv_action" translatable="false"></string>

    <!-- TVs with no TvInputManager have no HDMI list to read, but their own source-selection panel
         still switches inputs (TCL Android TV 9 again). When nothing could be listed, the Inputs menu
         offers one row that starts this service: component first, then action. Leave empty to omit. -->
    <string name="source_panel_service" translatable="false"></string>
    <string name="source_panel_action" translatable="false"></string>

    <!-- Inputs menu: HDMI and AV rows normally open with ACTION_VIEW on the input's channel URI, which the
         Live TV app handles. Where nothing answers that, this action is sent with the same URI instead
         (XGIMI projectors: com.xgimi.action.hdmiPlayer). Leave empty to omit. -->
    <string name="input_action" translatable="false"></string>

    <!-- Show the Solar Hijri (Shamsi) date used in Iran and Afghanistan, e.g. "27 Mehr 1405", above the
         Gregorian date. -->
    <bool name="shamsi_date">false</bool>
    <!-- Adhkar at the bottom of the Clock screensaver, a new one every minute (res/values/athkar.xml). -->
    <bool name="dream_athkar">true</bool>
    <!-- Today's prayer times at the weather coordinates below, from Aladhan (free, no account or key; only the
         coordinates, the date and the method are sent, once a day). home_prayer: the next prayer and a
         countdown in a glass pill under the clock. dream_prayer: the day's five times on the Clock screensaver.
         These two and dream_athkar can also be switched on the TV: Settings pill, then the rows at the bottom. -->
    <bool name="home_prayer">true</bool>
    <bool name="dream_prayer">true</bool>
    <!-- An analog clock on the Clock screensaver instead of the digital one. Also a switch in the Settings menu. -->
    <bool name="dream_analog">true</bool>
    <!-- Aladhan calculation method: 21 Morocco, 3 Muslim World League, 2 ISNA (North America), 4 Umm al-Qura,
         5 Egypt, 12 France, 13 Turkey; the full list is on aladhan.com/calculation-methods. -->
    <integer name="prayer_method">21</integer>
    <!-- Photos of the day from Bing behind the Clock screensaver, a new one every 3 minutes, kept on the TV
         for offline use. false: the dark glow only, and the screensaver makes no network requests besides
         the weather. -->
    <bool name="dream_photos">true</bool>
    <!-- While a music app (Spotify, ...) plays or is paused: a now playing pill left of Inputs (OK plays or
         pauses, hold OK opens the app) and the song on the Clock screensaver. Needs notification access,
         which the install script grants. -->
    <bool name="now_playing">true</bool>
    <!-- Today's photo of the day (Bing, the same as the screensaver) behind the home screen, with glass
         buttons and dock over it. A theme's wallpaper takes its place. false: the plain background. -->
    <bool name="home_photo">true</bool>
    <!-- Optional VPN app the network pill opens (hold the pill for Wi-Fi settings), e.g. the package of the
         VPN you use. Empty: the pill opens Wi-Fi settings. The green VPN badge shows for any VPN either way;
         with an app set here, a red "VPN off" badge also shows while no VPN is up. -->
    <string name="vpn_app" translatable="false"></string>
    <!-- Weather above the date, from Open-Meteo (free, no account or key; only these coordinates are
         sent). Leave the latitude empty to hide it. -->
    <string name="weather_latitude" translatable="false">33.5731</string>
    <string name="weather_longitude" translatable="false">-7.5898</string>
    <string name="weather_place" translatable="false">Casablanca</string>
    <!-- Grid rows left visible under the dock on the home screen. 0 = dock sits at the very bottom. -->
    <integer name="rows_below_dock">0</integer>
    <!-- How opaque the dock band's glass is over the photo or wallpaper, 0 to 100: 100 is the solid frosted
         band, lower lets more of the picture show through. -->
    <integer name="dock_opacity">55</integer>
    <!-- Dock slots. Tiles are 180dp wide at 4 and shrink to fit from 5 up (about 144dp at 5, 117dp at 6 on a
         1080p TV). -->
    <integer name="columns">4</integer>
    <!-- Tiles per row in the grid below the dock. More than columns gives smaller grid tiles. -->
    <integer name="grid_columns">5</integer>

    <!-- "Default home" tile that opens Android's home-screen picker, for TVs whose settings have one
         (most Android TVs don't; the tile only appears when the page exists). Off by default. -->
    <bool name="show_home_settings_shortcut">false</bool>

    <!-- Android turns the remote's key helpers (InputKeyService, HomeKeyService) off when the launcher is
         force-stopped (TV Manager's memory cleaner, Settings, am force-stop). true: Home puts back the helpers
         that were running when it starts again; one turned off in Settings stays off. Needs WRITE_SECURE_SETTINGS,
         which build-and-install grants. -->
    <bool name="restore_key_services">true</bool>

    <!-- Module cards: an app that declares a card (docs/specs/card.md) can stand in for its tile with its own
         label, caption and glow colour, once you answer Show on the prompt. false: never look for cards or ask. -->
    <bool name="module_cards">true</bool>
</resources>
